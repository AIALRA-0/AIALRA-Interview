{
  "name": "aialra-interview",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "foreign-cn:sync": "node scripts/expand-foreign-cn-companies.mjs",
    "questions:generate": "node scripts/generate-question-bank.mjs",
    "questions:editorial-audit": "node scripts/audit-question-editorial.mjs",
    "questions:build": "node scripts/build-question-assets.mjs",
    "questions:check": "node scripts/build-question-assets.mjs --check",
    "organizations:build": "node scripts/build-organization-assets.mjs",
    "organizations:check": "node scripts/build-organization-assets.mjs --check",
    "assets:build": "npm run questions:build && npm run organizations:build",
    "predev": "npm run assets:build",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "prebuild": "npm run assets:build",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "pretest": "npm run assets:build",
    "test": "npm run questions:editorial-audit && npm run questions:check && npm run organizations:check && npm run build && node --import ./tests/register-cloudflare.mjs --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "pretypecheck": "npm run assets:build",
    "typecheck": "tsc --noEmit --incremental false",
    "db:generate": "drizzle-kit generate",
    "audit:data": "node scripts/audit-data.mjs",
    "audit:links": "node scripts/audit-source-links.mjs",
    "validate": "npm run audit:data && npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.46.0",
    "@cloudflare/workers-types": "5.20260723.1",
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.8.0",
    "minimatch": "10.2.6",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "wrangler": "4.113.0"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "@esbuild-kit/core-utils@3.3.2": {
      "esbuild": "0.25.12"
    },
    "fast-uri": "3.1.4",
    "js-yaml": "4.3.0",
    "postcss": "8.5.22",
    "sharp": "0.35.3"
  },
  "type": "module"
}
